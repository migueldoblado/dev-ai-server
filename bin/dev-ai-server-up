#!/bin/bash
# dev-ai-server-up — create, bootstrap, and connect the dev server.
# Reads GPG + GitHub keys from $PERSONAL_SECRETS, injects them over SSH,
# clones the keys repo, and applies dotfiles — all automatic.

set -euo pipefail

SERVER_TYPE="${SERVER_TYPE:-cx23}"
LOCATION="${LOCATION:-fsn1}"
IMAGE="${IMAGE:-ubuntu-24.04}"
NAME="${NAME:-dev-ai}"
PERSONAL_SECRETS="${PERSONAL_SECRETS:-$HOME/.config/personal-secrets}"
SSH_KEY="$HOME/.ssh/hetzner_dev"
KEYS_REPO="${KEYS_REPO:-}"
DOTFILES_REPO="migueldoblado/dev-ai-server-dotfiles"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# ── preflight ──────────────────────────────────────────────
if [ ! -f "$SSH_KEY" ]; then
  echo "Missing: $SSH_KEY — generate with: ssh-keygen -t ed25519 -f $SSH_KEY" >&2
  exit 1
fi
if [ ! -f "$PERSONAL_SECRETS/ssh/github_personal" ]; then
  echo "Missing: $PERSONAL_SECRETS/ssh/github_personal" >&2
  echo "Missing bootstrap keys — see README prerequisites." >&2
  exit 1
fi
if [ -z "$KEYS_REPO" ]; then
  echo "KEYS_REPO not set — needs the git URL of your encrypted secrets repo." >&2
  exit 1
fi

# ── create server ──────────────────────────────────────────
echo "Creating server: $NAME ($SERVER_TYPE, $LOCATION, $IMAGE)"
hcloud server create --quiet \
  --name "$NAME" \
  --type "$SERVER_TYPE" \
  --location "$LOCATION" \
  --image "$IMAGE" \
  --user-data-from-file "$SCRIPT_DIR/../cloud-config.yaml"

echo "Waiting for IP..."
while true; do
  IP=$(hcloud server describe "$NAME" -o json 2>/dev/null | jq -r '.public_net.ipv4.ip // empty')
  if [ -n "$IP" ]; then
    echo "Server IP: $IP"
    break
  fi
  sleep 5
done

# ── ssh helpers ────────────────────────────────────────────
ssh_key()  { ssh  -i "$SSH_KEY" -o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new "$@"; }
scp_key()  { scp  -i "$SSH_KEY" -o StrictHostKeyChecking=accept-new "$@"; }

# ── wait for ssh + cloud-init ──────────────────────────────
echo "Waiting for SSH..."
ssh-keygen -R "$IP" 2>/dev/null || true
while ! ssh_key root@"$IP" echo ok 2>/dev/null; do sleep 5; done

# ── inject bootstrap secrets ───────────────────────────────
echo "Bootstrapping secrets..."
ssh_key root@"$IP" mkdir -p .ssh .gnupg
scp_key "$PERSONAL_SECRETS/ssh/github_personal" root@"$IP":.ssh/
scp_key "$PERSONAL_SECRETS/gpg/private.key"   root@"$IP":/tmp/private.key

ssh_key root@"$IP" KEYS_REPO="$KEYS_REPO" bash <<'BOOTSTRAP'
set -e
# GitHub SSH config
chmod 600 ~/.ssh/github_personal
cat > ~/.ssh/config <<'EOF'
Host github.com
  IdentityFile ~/.ssh/github_personal
EOF
chmod 600 ~/.ssh/config
# GPG key for pass
gpg --batch --import /tmp/private.key
rm /tmp/private.key
# Clone keys repo and apply dotfiles
pass git clone "$KEYS_REPO"
chezmoi init --apply migueldoblado/dev-ai-server-dotfiles
echo "Bootstrap complete."
BOOTSTRAP

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "Ready: ssh -i $SSH_KEY root@$IP && herdr"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"